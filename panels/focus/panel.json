{
  "schemaVersion": 1,
  "id": "focus",
  "title": "Focus",
  "version": "1.0.0",
  "rootClass": "focus-panel",
  "colorRole": "primary",
  "entries": {
    "html": "panel.html",
    "css": "panel.css",
    "js": "panel.js"
  },
  "capabilities": ["local-time", "storage"],
  "assets": [],
  "defaultEnabled": true,
  "type": "Productivity",
  "grid": {
    "columns": 1,
    "rows": 1
  },
  "expansion": {
    "sizes": [
      {
        "columns": 1,
        "rows": 1
      },
      {
        "columns": 2,
        "rows": 1
      },
      {
        "columns": 2,
        "rows": 2
      },
      {
        "columns": 2,
        "rows": 3
      }
    ],
    "pinch": true,
    "events": {
      "timerRun": {
        "action": "expand",
        "size": {
          "columns": 2,
          "rows": 2
        }
      },
      "timerPause": {
        "action": "retain"
      },
      "timerStop": {
        "action": "restore"
      },
      "timerComplete": {
        "action": "restore"
      }
    }
  }
}

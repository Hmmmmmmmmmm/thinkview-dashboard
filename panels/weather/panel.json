{
  "schemaVersion": 1,
  "id": "weather",
  "title": "Weather",
  "version": "1.0.0",
  "rootClass": "weather-panel",
  "colorRole": "secondary",
  "entries": {
    "html": "panel.html",
    "css": "panel.css",
    "js": "panel.js"
  },
  "capabilities": ["network", "location", "storage"],
  "assets": [],
  "defaultEnabled": true,
  "networkOrigins": [
    "https://api.open-meteo.com",
    "https://geocoding-api.open-meteo.com"
  ],
  "type": "Weather",
  "grid": {
    "columns": 1,
    "rows": 1
  },
  "expansion": {
    "sizes": [
      {
        "columns": 1,
        "rows": 1
      },
      {
        "columns": 2,
        "rows": 1
      },
      {
        "columns": 2,
        "rows": 2
      },
      {
        "columns": 2,
        "rows": 3
      }
    ],
    "pinch": true,
    "events": {}
  }
}
